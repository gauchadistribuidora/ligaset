# Copie este arquivo para .env.local e preencha os valores.
# O .env.local NUNCA vai para o Git. Em produção, estas variáveis ficam na Vercel
# (Settings > Environment Variables).

# --- Supabase (obrigatório) ---
# Painel: Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://izjrqunvwxhaspbxjsht.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole_aqui_a_anon_key

# Chave de servidor (service role). Dá acesso total ao banco, ignorando o RLS.
# Só é usada em código de servidor (lib/supabase/admin.ts). Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=cole_aqui_a_service_role_key
SUPABASE_SECRET_KEY=cole_aqui_a_secret_key

# --- Site ---
# URL base usada nos links de e-mail e no retorno do login.
# Local: http://localhost:3000 | Produção: https://ligaset.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- E-mail (Resend) ---
# Necessário para convites, relatórios e comunicados. Painel: resend.com > API Keys
RESEND_API_KEY=cole_aqui_a_chave_do_resend
EMAIL_FROM=Ligaset <nao-responda@ligaset.com.br>

# --- Admin da plataforma ---
# E-mails com acesso total ao painel /app/admin, separados por vírgula.
PLATFORM_ADMIN_EMAILS=gauchadistribuidora@gmail.com
